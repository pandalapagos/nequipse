# --- Runtime ---
NODE_ENV=production
PORT=8080

# --- Telegram (REQUIRED) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
# auto = solo 1 proceso hace polling (evita error 409). false/true para forzar.
TELEGRAM_POLLING=auto

# --- Security ---
# Azure App Service sits behind a reverse proxy: trust 1 hop
TRUST_PROXY=1
FORCE_HTTPS=true
CORS_ORIGIN=https://your-domain.com

# --- Endpoint rotation (optional but recommended) ---
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROTATION_SECRET=

# --- Redis (REQUIRED if WORKERS>1 or varias instancias con cluster) ---
# Sin Redis, el cliente y el botón Telegram pueden quedar en workers distintos.
# REDIS_URL=redis://:password@host:6379
