# --- Runtime ---
NODE_ENV=production
PORT=8080

# --- Telegram (REQUIRED en Render: Environment) ---
# Si Render tiene variables viejas, borra o actualiza TELEGRAM_BOT_TOKEN y TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=-5218723082
# Por defecto usa POLLING (como la versión antigua). Solo 1 instancia del servicio en Render.
TELEGRAM_POLLING=true
# USE_TELEGRAM_WEBHOOK=true  solo si quieres webhook en lugar de polling
# PUBLIC_URL=https://tu-app.onrender.com  si no usas Render

# --- Security ---
# Azure App Service sits behind a reverse proxy: trust 1 hop
TRUST_PROXY=1
FORCE_HTTPS=true
CORS_ORIGIN=https://your-domain.com

# --- Endpoint rotation (optional but recommended) ---
# Generate once: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ROTATION_SECRET=

# --- Redis (optional, only when scaling to multi-instance) ---
# REDIS_URL=redis://:password@host:6379
